<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameHub</title>
  
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/general.css" />
    <link rel="stylesheet" href="/css/home.css" />

    <script type="module" src="/js/main.js"></script>
    <script type="module" src="/js/home.js"></script>
  </head>

  <body>
    <header>
      <% if (typeof message !== 'undefined' && message) { %>
         <p id="flash-message" class="<%= message.type %>"><%= message.message %></p>
      <% } %>
      <%- include("partials/navigation") %>
      <h1>Gamehub</h1>
    </header>

    <main>
      <section class="friends">
  <h3>Vrienden <img src="./assets/right-arrow.png" /></h3>
  <ul id="list-friends">
    <% if (typeof friendsList !== 'undefined' && friendsList.length > 0) { %>
      <% for(const friend of friendsList) { %>
        <li>
          <a href="/user/<%= friend.id %>" class="friend-link">
            <img src="/assets/<%= friend.userIcon %>" alt="<%= friend.name %>" />
            <p><%= friend.name %></p>
          </a>
        </li>
      <% } %>
    <% } else { %>
      <p style="padding: 10px;">Nog geen vrienden toegevoegd.</p>
    <% } %>

    <li class="addFriend">
      <img src="./assets/pluscircle.png" />
    </li>
  </ul>
</section>

      <section class="addFriendUi">
        <h4>Voeg vriend toe <img class="closeFriendUi" src="/assets/x-icon.png"></h4>
        
        <form action="/addfriend" method="POST">
          <label for="friendId">ID van vriend:</label>
          <input type="text" name="friendId" id="friendId" required>
          <button type="submit">Voeg toe</button>
        </form>
      </section> <section class="favorites">
        <h3>Favorieten <img src="./assets/right-arrow.png" /></h3>
        <% if (typeof favoriteGames !== 'undefined' && favoriteGames.length > 0) { %>
          <ul class="game-cards" id="list-favorites">
            <% for(const game of favoriteGames) { %>
            <li>
              <a href="/game/<%= game.id %>" id="game-item<%= game.id %>" class="game-items">
                <img src="<%= game.thumbnail %>" alt="<%= game.title %>">
                <em><%= game.title %></em>
                <p><%= game.developer %></p>
              </a>
            </li>
            <% } %>
          </ul>
        <% } else{ %>
          <p>Nog geen favorieten </p>
        <% } %>
      </section>

      <section class="games">
        <h3>Games <img src="./assets/right-arrow.png" /></h3>
        <ul class="game-cards" id="list-games">
          <% if (typeof games !== 'undefined') { %>
            <% for(const game of games) { %>
              <li>
                <a href="/game/<%= game.id %>" id="game-item<%= game.id %>" class="game-items">
                  <img src="<%= game.thumbnail %>" alt="<%= game.title %>">
                  <em><%= game.title %></em>
                  <p><%= game.developer %></p>
                </a>
              </li>
            <% } %>
          <% } %>
        </ul>

        <a href="/games">Ontdek meer</a>
      </section>
    </main>
  </body>
</html>