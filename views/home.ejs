<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameHub</title>
  
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/general.css" />
    <link rel="stylesheet" href="/css/home.css" />

    <script type="module" src="/js/main.js"></script>
    <script type="module" src="/js/home.js"></script>
  </head>

  <body>
    <header>
      <% if (message) { %>
         <p id="flash-message" class="<%= message.type %>"><%= message.message %></p>
        <% } %>
      <%- include("partials/navigation") %>
      <h1>Gamehub</h1>
    </header>

    <main>
      <section class="friends">
        <h3>Vrienden <img src="./assets/right-arrow.png" /></h3>
        <ul id="list-friends">
          <li>
            <img src="./assets/falloutprofilepicture.png" />
            <p>Vriend</p>
          </li>
          <li>
            <img src="./assets/haloprofilepicture.jpg" />
            <p>Vriend</p>
          </li>
          <li>
            <img src="./assets/Minecraft-Steve-Head-profilepicture.jpg" />
            <p>Vriend</p>
          </li>
          <li class="addFriend">
            <img src="./assets/pluscircle.png" />
          </li>
        </ul>
      </section>

      <section class="addFriendUi">
        <h4>Voeg vriend toe <img class="closeFriendUi" src="/assets/x-icon.png"></h4>
        

        <form action="/home" method="POST">
          <label for="">ID:</label>
          <input type="text">
          <button type="submit">Voeg toe</button>
        </form>
      </section>

      <section class="favorites">
        <h3>Favorieten <img src="./assets/right-arrow.png" /></h3>
        <% if (favoriteGames.length > 0) { %>
          <ul class="game-cards" id="list-favorites">
            <% for(const game of favoriteGames) { %>
            <li>
              <a href="/game/<%= game.id %>" id="game-item<%= game.id %>" class="game-items">
                <img src="<%= game.thumbnail %>" alt="<%= game.title %>">
                <em><%= game.title %></em>
                <p><%= game.developer %></p>
              </a>
            </li>
            <% } %>
          </ul>
        <% } else{ %>
          <p>Nog geen favorieten </p>
        <% } %>
      </section>

      <section class="games">
        <h3>Games <img src="./assets/right-arrow.png" /></h3>
        <ul class="game-cards" id="list-games">
          <% for(const game of games) { %>
            <li>
              <a href="/game/<%= game.id %>" id="game-item<%= game.id %>" class="game-items">
                <img src="<%= game.thumbnail %>" alt="<%= game.title %>">
                <em><%= game.title %></em>
                <p><%= game.developer %></p>
              </a>
            </li>
          <% } %>
        </ul>

        <a href="/games">Ontdek meer</a>
      </section>
    </main>
  </body>
</html>
