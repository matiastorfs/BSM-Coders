<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameHub</title>
  
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/general.css" />
    <link rel="stylesheet" href="/css/home.css" />

    <script type="module" src="/js/main.js"></script>
    <script type="module" src="/js/home.js"></script>
  </head>

  <body>
    <header>
      <% if (message) { %>
         <p id="flash-message" class="<%= message.type %>"><%= message.message %></p>
        <% } %>
      <%- include("partials/navigation") %>
      <h1>Gamehub</h1>
    </header>

    <main>
      <section class="friends">
        <h3>Vrienden <img src="./assets/right-arrow.png" /></h3>
        <ul id="list-friends">
          <li>
            <img src="./assets/user-icon.png" />
            <p>Vriend</p>
          </li>
          <li>
            <img src="./assets/user-icon.png" />
            <p>Vriend</p>
          </li>
          <li>
            <img src="./assets/user-icon.png" />
            <p>Vriend</p>
          </li>
        </ul>
      </section>

      <section class="favorites">
        <h3>Favorieten <img src="./assets/right-arrow.png" /></h3>
        <ul class="game-cards" id="list-favorites">
          <p>Je hebt nog geen favorieten games.</p>
        </ul>
      </section>
    </main>
  </body>
</html>
