    <a href="/guess-that-game" id="gtgbuttonnav">
      <img src="/assets/guess-icon.png" />
      <em>Raad Het Spel</em>
    </a>
    <a href="/settings" id="settingsbuttonnav">
      <img src="/assets/setting-icon.png" />
      <em>Instellingen</em>
    </a>
  </section>
</nav>