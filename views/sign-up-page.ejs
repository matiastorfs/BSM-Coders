<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="./css/reset.css" />
    <link rel="stylesheet" href="./css/general.css" />
    <link rel="stylesheet" href="./css/login.css" />

    <script type="module" src="./js/login.js"></script>
  </head>
  <body>
    <header>
      <h1>Registreren</h1>
      <img src="./assets/left-arrow.png" id="arrow" />
    </header>
    <main>
      <form action="/signin" method="post">
        <input type="hidden" name="userIcon" value="userdefaultimage.jpg">
        <label for="name/email">Naam</label>
        <input
          type="text"
          name="name"
          id="name"
          placeholder="Vul in"
          required
        />

        <label for="name/email">Email</label>
        <input
          type="email"
          name="email"
          id="email"
          placeholder="Vul in"
          required
        />

        <label for="password">Wachtwoord</label>
        <input
          type="password"
          name="password"
          id="password"
          placeholder="Vul in"
          required
        />

        <label for="password2">Herhaal Wachtwoord</label>
        <input
          type="password"
          name="passwordConfirm"
          id="password2"
          placeholder="Vul in"
          required
        />

        <div class="checkbox-group">
          <input
            type="checkbox"
            class="checkmark"
            id="termsofservice"
            name="termsofservice"
            required
          />
          <label for="termsofservice">Accepteer Algemene Voorwaarde</label>
        </div>
        <a id="showtermsofservice" href="/algemenevoorwaarde.html">Laat zien</a>
      <a id="forgotpassword">Wachtwoord vergeten?</a>

      <button id="signupbutton">Registreren</button>
      </form>
      <p>OF</p>
      <button
        id="loginbutton"
        onclick="window.location.href = '/login'"
      >
        Login
      </button>
    </main>
  </body>
</html>
