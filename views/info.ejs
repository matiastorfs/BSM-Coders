<!doctype html>
<html lang="nl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title id="title">GameHub</title>

  <link rel="stylesheet" href="/css/reset.css" />
  <link rel="stylesheet" href="/css/general.css" />
  <link rel="stylesheet" href="/css/info.css" />

  <script type="module" src="/js/main.js"></script>
  <script type="module" src="/js/info.js"></script>
</head>

<body>
  <header>
    <%- include("partials/navigation") %>

      <section id="go-back">
        <button class="previous-page">
          <img src="/assets/left-arrow3.png" id="arrow" />
        </button>
      </section>
  </header>

  <main>
    <h2 id="info-title"><%= game.title %></h2>
    <section class="infopage">
      <section class="info-cover">
        <img src="<%= game.thumbnail %>" id="item-cover" />
        <form method="POST" action="/favorite/<%= game.id %>">
          <button  type="submit"  id="btn-favorite" class="<%= isFavorite ? 'favorite-active' : '' %>">
            <%= isFavorite 
              ? 'Verwijder uit favorieten'
              : 'Toevoegen aan favorieten'
            %>
          </button>
        </form>
      </section>
      <ul class="info-list">
        <li id="item-description"><em>Beschrijving</em><%= game.short_description %></li>
        <li id="item-developer"><em>Ontwikkelaar</em><%= game.developer %></li>
        <li id="item-publisher"><em>Uitgever</em><%= game.publisher %></li>
        <li id="item-platforms"><em>Platforms</em><%= game.platform %></li>
        <li id="item-genre"><em>Genre</em><%= game.genre %></li>
        <li id="item-releaseDate"><em>Releasedatum</em><%= game.release_date %></li>
      </ul>
    </section>
  </main>
</body>

</html>