<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/general.css" />
    <link rel="stylesheet" href="/css/account.css" />

    <script type="module" src="/js/main.js"></script>
    <script type="module" src="/js/account.js"></script>
  </head>
  <body>
    <% if (message) { %>
         <p id="flash-message" class="<%= message.type %>"><%= message.message %></p>
      <% } %>
    <header>
      <%- include("partials/navigation") %>

      <img src="./assets/left-arrow.png" id="arrow" />
      <p>Games</p>
    </header>
    <main>
      <div class="profile">
        <div class="profile-image-container">
        <img src="/assets/<%= user.userIcon %>" id="userlogo" alt="Profielfoto" />
        <div class="profile-image-overlay">
        <img src="/assets/edit_profile_picture.png" class="edit-icon" alt="Bewerk icoon" />
        </div>
        </div>

        <div class="usertext">
          <p id="username"><%= user.name %><span id="userid">#<%= user.id %></span></p>
          <p id="userdescription"><%= user.data.beschrijving %></p>
          <button id="accountsettingsbutton">
            <a href="/settings">
            Account settings
            <img src="./assets/setting-icon.png" id="accountsettingsicon" />
            </a>
          </button>
        </div>
      </div>
      <div class="titles-container">
        <h1 id="tab-projecten">Collecties</h1>
        <h1 id="tab-prestaties">Prestaties</h1>
      </div>

      <div id="lijst-container">
        <section id="collecties-section" class="favorites">
          <% if (favoriteGames.length > 0) { %>
            <ul class="game-cards" id="list-favorites">
              <% for(const game of favoriteGames) { %>
              <li>
                <a href="/game/<%= game.id %>">
                  <img src="<%= game.thumbnail %>">
                  <em><%= game.title %></em>
                  <p><%= game.developer %></p>
                </a>
              </li>
              <% } %>
            </ul>
          <% } %>
        </section>

        <section id="prestaties-section" class="favorites" style="display: none;">
          <% if (user.data.achievements && user.data.achievements.length > 0) { %>
            <% user.data.achievements.forEach(prestatie => { %>
              <div class="prestatie-item">
                <h3><%= prestatie.title %></h3>
                <p><%= prestatie.description %></p>
              </div>
            <% }) %>
          <% } else { %>
            <p>Nog geen prestaties behaald.</p>
          <% } %>

        </section>
      </div>
    </main>
    <div class="changelogo">  
      <h1 id="changelogotitle">Verander Profielfoto</h1>
      <span class="close-button">&times;</span>
      
      <form id="profile-form" action="/update-profile-picture" method="POST">
        <input type="hidden" name="selectedIcon" id="selected-icon-input">
        
        <div class="images-row">
          <img src="./assets/Minecraft-Steve-Head-profilepicture.jpg" class="profilepictures" data-icon="Minecraft-Steve-Head-profilepicture.jpg">
          <img src="./assets/falloutprofilepicture.png" class="profilepictures" data-icon="falloutprofilepicture.png">
          <img src="./assets/haloprofilepicture.jpg" class="profilepictures" data-icon="haloprofilepicture.jpg">
        </div>
      </form>
      
      <p id="instructies">klik op de profielfoto die je wilt</p>
    </div>
  </body>
</html>
